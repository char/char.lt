{
  "imports": {
    "@arborium/arborium": "npm:@arborium/arborium@^2.18.1",
    "@lume": "https://deno.land/x/lume@v3.2.0/mod.ts",
    "@lume/cli": "https://deno.land/x/lume@v3.2.0/cli.ts",
    "@lume/types": "https://deno.land/x/lume@v3.2.0/types.ts",
    "@lume/plugins/": "https://deno.land/x/lume@v3.2.0/plugins/",
    "@lume/deps/": "https://deno.land/x/lume@v3.2.0/deps/",
    "@lume/utils/": "https://deno.land/x/lume@v3.2.0/core/utils/"
  },
  "tasks": {
    "lume": "echo \"import '@lume/cli'\" | deno run -A - --config ./_lume.ts",
    "build": "deno task lume",
    "serve": "deno task lume -s"
  },
  "unstable": ["temporal"],
  "lint": {
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.0/lint.ts"
    ]
  },
  "compilerOptions": {
    "types": ["@lume/types"]
  }
}
